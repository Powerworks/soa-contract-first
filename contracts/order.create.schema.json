{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Order Create Contract",
  "description": "Contract between order-service and its clients.",
  "type": "object",
  "required": ["item", "quantity"],
  "properties": {
    "item": { "type": "string", "enum": ["widget", "gadget"] },
    "quantity": { "type": "integer", "minimum": 1 }
  },
  "response": {
    "type": "object",
    "required": ["order_id", "status"],
    "properties": {
      "order_id": { "type": "string" },
      "status": { "type": "string", "enum": ["accepted", "rejected"] },
      "total": { "type": "number" }
    }
  }
}
